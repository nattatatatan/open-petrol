# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real keys.

# Data source: "snapshot" (demo, default) | "live" (real FuelCheck API)
SOURCE=snapshot

# NSW FuelCheck (only needed when SOURCE=live). Register an app at https://api.nsw.gov.au
FUELCHECK_API_KEY=
FUELCHECK_API_SECRET=

# The "fill up now or wait?" advisor is deterministic (engine/cycle.py) — no LLM,
# no API key, no network on its path (CLAUDE.md §6). Nothing to configure here.

# Scheduled refresh interval in minutes (30–60 keeps dev under the free tier).
REFRESH_INTERVAL_MINUTES=45
